# Production environment for muss6.org.
# In the VPS deployment these values are injected via docker-compose `environment:`
# (sourced from deploy/vps/.env). This file documents what the website needs.
# Generate APP_KEY once with:  docker run --rm ghcr.io/foyo-ai/openmu-website:production php artisan key:generate --show

APP_NAME=muss6
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://muss6.org
APP_SSL=true

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Game database — internal Postgres in the openmu compose network.
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=openmu
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_same_as_DB_ADMIN_PW

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# Live online count — the game container, reachable on the internal network.
OPENMU_API_URL=http://openmu-startup:8080

# Landing-page server info (override the defaults in config/server.php)
SERVER_SEASON="Season 6"
SERVER_EXP_RATE=50x
SERVER_DROP_RATE=30%
SERVER_CONNECT_HOST=connect.muss6.org
SERVER_CONNECT_PORT=44405
SERVER_DISCORD_URL=https://discord.gg/your-invite
SERVER_DOWNLOAD_FULL=https://your-download-link
